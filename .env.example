# Variables públicas del cliente. La anon key de Supabase está diseñada para
# exponerse en el navegador; la seguridad depende de RLS y de las funciones SQL.
NEXT_PUBLIC_SUPABASE_URL=
# Nombre actual usado por la integración oficial de Supabase en Vercel.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con proyectos Supabase creados anteriormente.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Calendar permanece desactivado por defecto. Sólo una decisión futura
# explícita debe cambiar este flag a 1 y volver a configurar el proyecto OAuth.
NEXT_PUBLIC_GOOGLE_CALENDAR_ENABLED=0
# Funciones P2: todas permanecen apagadas hasta validar su etapa y activar
# explícitamente el rollout correspondiente.
NEXT_PUBLIC_FEATURE_WEEKLY_RECAP=0
NEXT_PUBLIC_FEATURE_RETURN_EXPERIENCE=0
NEXT_PUBLIC_FEATURE_SHARE_CARDS=0
NEXT_PUBLIC_FEATURE_REFERRALS=0
NEXT_PUBLIC_FEATURE_PREMIUM_CONTEXTUAL_PROMPTS=0
# Las variables siguientes son exclusivamente de servidor: nunca les agregues
# el prefijo NEXT_PUBLIC_ ni expongas sus valores al navegador o a respaldos.
APP_BASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Secreto aleatorio exclusivo de al menos 32 bytes usado para AES-GCM. Genera
# uno nuevo para cada entorno (por ejemplo, con `openssl rand -base64 32`).
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Vercel Cron envía este valor como `Authorization: Bearer …` al mantenimiento.
CRON_SECRET=

# Facturación server-side. Déjalo desactivado hasta confirmar expresamente que
# las nuevas compras deben ser suscripciones automáticas y completar el sandbox.
MERCADO_PAGO_BILLING_MODE=
MERCADO_PAGO_ACCESS_TOKEN=
# Firma secreta configurada para el webhook de Mercado Pago (mínimo 32 caracteres).
MERCADO_PAGO_WEBHOOK_SECRET=
# Destinatario opcional de alertas internas; no concede permisos administrativos.
ADMIN_NOTIFICATION_EMAIL=

# Correo transaccional server-side mediante Resend. Si falta cualquiera de los
# valores requeridos, mantenimiento no reclama mensajes de la cola.
TRANSACTIONAL_EMAIL_ENABLED=0
RESEND_API_KEY=
# Dominio verificado provisto por la integración. Construye por defecto los
# remitentes hola@dominio y soporte@dominio.
RESEND_EMAIL_DOMAIN=
# Overrides opcionales del remitente, respuesta y dirección visible de soporte.
TRANSACTIONAL_EMAIL_FROM=
TRANSACTIONAL_EMAIL_REPLY_TO=
TRANSACTIONAL_EMAIL_SUPPORT_EMAIL=

# No definas NEXT_PUBLIC_MBV_E2E_ACCESS fuera de pruebas automatizadas.

# Identidad legal verificable. No publiques valores ficticios.
NEXT_PUBLIC_LEGAL_RESPONSIBLE_NAME=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_CITY_COUNTRY=Colombia
NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_PQR_EMAIL=
NEXT_PUBLIC_LEGAL_SUPPORT_PHONE=
NEXT_PUBLIC_LEGAL_OFFICIAL_DOMAIN=https://mybestversion.life
NEXT_PUBLIC_LEGAL_PAYMENT_PROVIDER=Mercado Pago
