# Variables públicas del cliente. La anon key de Supabase está diseñada para
# exponerse en el navegador; la seguridad depende de RLS y de las funciones SQL.
NEXT_PUBLIC_SUPABASE_URL=
# Nombre actual usado por la integración oficial de Supabase en Vercel.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con proyectos Supabase creados anteriormente.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Calendar es una autorización opcional e independiente del inicio de
# sesión. Estas variables son exclusivamente de servidor: nunca les agregues
# el prefijo NEXT_PUBLIC_ ni expongas sus valores al navegador o a respaldos.
APP_BASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Secreto aleatorio exclusivo de al menos 32 bytes usado para AES-GCM. Genera
# uno nuevo para cada entorno (por ejemplo, con `openssl rand -base64 32`).
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Vercel Cron envía este valor como `Authorization: Bearer …` al mantenimiento.
CRON_SECRET=

# Checkout externo. No confirma ni activa Premium por sí solo.
NEXT_PUBLIC_MERCADO_PAGO_URL=https://link.mercadopago.com.co/mybestversion

# No definas NEXT_PUBLIC_MBV_E2E_ACCESS fuera de pruebas automatizadas.

# Identidad legal verificable. No publiques valores ficticios.
NEXT_PUBLIC_LEGAL_RESPONSIBLE_NAME=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_CITY_COUNTRY=Colombia
NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_PQR_EMAIL=
NEXT_PUBLIC_LEGAL_SUPPORT_PHONE=
NEXT_PUBLIC_LEGAL_OFFICIAL_DOMAIN=https://mybestversion.life
NEXT_PUBLIC_LEGAL_PAYMENT_PROVIDER=Mercado Pago
